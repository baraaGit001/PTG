{
  "name": "ptg-business",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.5.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm build:packages && pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm build:packages && pnpm --filter @ptg/api dev",
    "dev:web": "pnpm build:packages && pnpm --filter @ptg/web dev",
    "dev:admin": "pnpm build:packages && pnpm --filter @ptg/admin dev",
    "build:packages": "pnpm --filter @ptg/types --filter @ptg/config build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @ptg/web test:e2e",
    "db:generate": "pnpm --filter @ptg/api db:generate",
    "db:migrate": "pnpm --filter @ptg/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @ptg/api db:migrate:deploy",
    "db:seed": "pnpm --filter @ptg/api db:seed",
    "db:reset": "pnpm --filter @ptg/api db:reset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "eslint": "8.57.0",
    "prettier": "3.3.3",
    "typescript": "5.5.4"
  }
}
