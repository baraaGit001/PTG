# ---------------------------------------------------------------------------
# PTG Business - environment for the live server.
#
# Template. Copy to deploy/server.env (gitignored) and replace every
# `generate-me` with fresh random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
#
# update-server.bat uploads deploy/server.env to ~/PTG/.env on every deploy, so this is
# the single place to change production configuration. It is NOT the same file
# as the repo-root .env, which stays pointed at localhost for development.
#
# Hostnames here are compose service names (postgres, redis, minio), not localhost: the
# API runs inside the stack and reaches its dependencies over that network.
# ---------------------------------------------------------------------------

NODE_ENV=production

# --- Database ---------------------------------------------------------------
POSTGRES_USER=ptg
POSTGRES_PASSWORD=generate-me
POSTGRES_DB=ptg
DATABASE_URL=postgresql://ptg:generate-me@postgres:5432/ptg?schema=public

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Auth -------------------------------------------------------------------
JWT_SECRET=generate-me-at-least-32-characters-long
JWT_REFRESH_SECRET=generate-me-at-least-32-characters-long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
COOKIE_SECRET=generate-me-at-least-16-characters
# Deliberately empty. The site is served from a bare IP, and a cookie whose
# Domain attribute is an IP address is rejected outright by every browser -
# empty means "host-only", which is what is wanted here anyway.
COOKIE_DOMAIN=
# Must stay false until TLS is terminated in front of the proxy: a Secure
# cookie set over plain http is dropped silently and sign-in stops working.
COOKIE_SECURE=false

# --- Object storage (MinIO inside the stack) --------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ptg_minio
S3_SECRET_KEY=generate-me
S3_BUCKET=ptg-media
S3_FORCE_PATH_STYLE=true
# MinIO is not published to the host; browsers reach objects through the
# proxy's /media/ location (see infra/nginx/server-proxy.conf).
S3_PUBLIC_URL=http://YOUR.SERVER.IP/media/ptg-media

# --- URLs -------------------------------------------------------------------
API_PORT=3001
API_URL=http://YOUR.SERVER.IP/api/v1
APP_URL=http://YOUR.SERVER.IP
ADMIN_URL=http://YOUR.SERVER.IP:4000
CORS_ORIGINS=http://YOUR.SERVER.IP,http://YOUR.SERVER.IP:3000,http://YOUR.SERVER.IP:4000

# --- Platform behaviour -----------------------------------------------------
DEFAULT_CURRENCY=ZAR
DEFAULT_LOCALE=en
DEMO_MODE=false

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Frontend (Vite, baked in at image build time) --------------------------
# Same-origin: the proxy serves the SPA and the API from one host, so no CORS
# preflight and no absolute URL to keep in sync.
VITE_API_URL=/api/v1
VITE_BRAND_NAME=PTG Business
VITE_BRAND_LOGO_URL=
