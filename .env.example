# ---------------------------------------------------------------------------
# PTG Business — example environment. Copy to .env and fill in real values.
# NEVER commit a real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database ---------------------------------------------------------------
POSTGRES_USER=ptg
POSTGRES_PASSWORD=ptg_dev_password
POSTGRES_DB=ptg
DATABASE_URL=postgresql://ptg:ptg_dev_password@localhost:5432/ptg?schema=public

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth -------------------------------------------------------------------
JWT_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
COOKIE_SECRET=change-me-cookie-secret-at-least-32-characters
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- Object storage (S3 compatible: MinIO in dev) ---------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ptg_minio
S3_SECRET_KEY=ptg_minio_password
S3_BUCKET=ptg-media
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/ptg-media

# --- URLs -------------------------------------------------------------------
API_PORT=3001
API_URL=http://localhost:3001
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Platform behaviour (admin-overridable via SystemSetting) ---------------
DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=en
DEMO_MODE=true

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Frontend (Vite) --------------------------------------------------------
VITE_API_URL=http://localhost:3001/api/v1
VITE_BRAND_NAME=PTG Business
VITE_BRAND_LOGO_URL=
